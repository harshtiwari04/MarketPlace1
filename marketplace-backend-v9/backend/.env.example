# ── Email (Nodemailer over SMTP) ───────────────────────────────────────────
# Any SMTP relay works. Gmail/Google Workspace: enable 2-Step Verification, create an App Password
# (myaccount.google.com/apppasswords) and use it as SMTP_PASS. Sending limits: ~500/day (gmail.com),
# 2000/day (Workspace). For higher volume use Brevo, Zoho ZeptoMail, or SES SMTP — same variables.
# Leave SMTP_USER/SMTP_PASS blank locally and emails are logged instead of sent. Required in production.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# SMTP_SECURE=true          # derived from the port when unset (465 → true, 587 → false/STARTTLS)
SMTP_USER=collectionexpress06@gmail.com
SMTP_PASS=wqix pyfw twvl lpva
# Must be an address the SMTP account is allowed to send as (Gmail rewrites it to SMTP_USER otherwise).
EMAIL_FROM=Marketplace <collectionexpress06@gmail.com>

# ── Error monitoring (optional — leave unset to skip) ──────────────────────
SENTRY_DSN=
