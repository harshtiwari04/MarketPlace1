# ── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed browser origins (exact match, no trailing slash).
CLIENT_URL=http://localhost:5173
# Reverse-proxy hops in front of the app. Render API alone = 1; Render static-site rewrite → API = 2.
TRUST_PROXY=1

# ── Database ──────────────────────────────────────────────────────────────
# Transactions require a replica set (Atlas clusters are replica sets by default).
# A plain local `mongod` is NOT one — use `docker compose up mongo` (pre-configured) or an Atlas M0.
MONGO_URI=mongodb+srv://harshknp1ar_db_user:guCG3ITe1PKpnGEO@cluster0.qgnfdfa.mongodb.net/?appName=Cluster0

# Pool per process. Keep MAX × (number of instances) well under your cluster's connection cap (Atlas M0 = 500).
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=5

# ── Auth / Crypto (generate each with: openssl rand -hex 32) ──────────────
JWT_SECRET=f3b3f07b4946eb678f7d9c504cfee933a413cf5208edc14fec6226c30b2aaba7

JWT_EXPIRES_IN=15m
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECRET=bb315eadfaa70505c063c17b6b64529bf08064b870d85c824c4b5b61c89d4b3a

OTP_HASH_SECRET=3d2bdafdde6371f27e1c3b18a71866adb8610adcd2b543821ae9e2c04b19017d

# Cookie SameSite. Production default is "none" (cross-site SPA↔API). Set "lax" when the SPA proxies
# /api to this server so both are one origin — recommended, see docs/DEPLOYMENT.md.
# COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=

# ── Admin bootstrap ────────────────────────────────────────────────────────
# Comma-separated emails promoted to `admin` on their next sign-in. Alternatively:
#   npm run make-admin -- you@example.com
ADMIN_EMAILS=admin@MarketPlace.com

