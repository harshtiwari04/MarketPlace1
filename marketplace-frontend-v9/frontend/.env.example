# Base path for API calls. Keep it same-origin (/api/v1): locally the Vite dev proxy forwards it, on
# Render the static site's rewrite rule forwards it. Same-origin = first-party cookies = works in
# Safari/Brave too. Only set a full https://…/api/v1 URL if you also own a shared parent domain
# (see backend docs/DEPLOYMENT.md).
VITE_API_BASE_URL=/api/v1
# Backend origin used by the Vite dev proxy
VITE_PROXY_TARGET=http://localhost:5000
# Razorpay public key id (public, safe in the browser). The KEY SECRET must never be here.
VITE_RAZORPAY_KEY_ID=rzp_test_TZufRd4eFdUOHJ
# Google OAuth "Web application" client ID (public, safe in the browser) — must match the
# backend's GOOGLE_CLIENT_ID exactly, since the backend verifies tokens against this audience.
VITE_GOOGLE_CLIENT_ID=81270977226-699khg6a4657s62k5gf081mi85fpcvrm.apps.googleusercontent.com  # REQUIRED for the Google button to render at all
VITE_APP_NAME=Marketplace
